# Copy to .env; do not commit your real credentials.
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL_ID=gpt-6-luna
OPENAI_FALLBACK_MODEL_ID=gpt-5.4-mini
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MAX_TOKENS=2048
OPENAI_MAX_TOKENS_CAP=16384
OPENAI_RETRIES=5
OPENAI_QUALITY_FAILURES_BEFORE_FALLBACK=2
OPENAI_TIMEOUT_SECONDS=45
OPENAI_RETRY_MAX_DELAY_SECONDS=12
OPENAI_RETRY_JITTER_SECONDS=0.3
OPENAI_REASONING_EFFORT=none
OPENAI_RAW_RESPONSE_LOG_CHARS=4000
# SHA-256 hex digests (JSON array); only hashes, never plaintext keys.
# The standalone VPS Compose project forces LOCALIZER_REQUIRE_API_KEY=true.
LOCALIZER_REQUIRE_API_KEY=false
LOCALIZER_API_KEY_HASHES=[]
# Keep anonymous demo disabled until HTTPS/Caddy allowlist is verified.
LOCALIZER_DEMO_ENABLED=false
LOCALIZER_DEMO_DAILY_LIMIT=20
LOCALIZER_DEMO_PER_IP_HOUR_LIMIT=3
CORS_ORIGINS=[]
HOST=127.0.0.1
PORT=8080
