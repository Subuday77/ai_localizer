# Copy to .env; do not commit your real credentials.
NVIDIA_API_KEY=your-nvidia-api-key
NVIDIA_MODEL_ID=your-model-id
NVIDIA_FALLBACK_MODEL_ID=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MAX_TOKENS=2048
NVIDIA_MAX_TOKENS_CAP=16384
NVIDIA_RETRIES=5
NVIDIA_TIMEOUT_SECONDS=45
NVIDIA_RETRY_MAX_DELAY_SECONDS=12
NVIDIA_RETRY_JITTER_SECONDS=0.3
NVIDIA_ENABLE_THINKING=false
NVIDIA_RAW_RESPONSE_LOG_CHARS=4000
CORS_ORIGINS=[]
HOST=127.0.0.1
PORT=8080
